// 数据模型（冻结）—— 权威来源：接口契约决策 I-7
//
// 三条 SQLite 特有硬约束（决策 I-0 / I-7）：
//   1. 枚举列全部为 String。Prisma 在 SQLite 上不支持原生 `enum`，写了会直接报错；
//      取值合法性由 `src/shared/validation.ts` 的 Zod 枚举保证，数据库层不做约束。
//   2. `planStart` / `planEnd` 为 String（'YYYY-MM-DD'），与接口契约完全一致；
//      `createdAt` 为 DateTime，序列化层负责转 ISO 8601 UTC 字符串。
//   3. 删除保护全部用 `onDelete: Restrict`（`ProjectMember` 除外，用 `Cascade`）。
//
// 注意：本文件与契约决策 I-7 的 Prisma schema 逐字对应，禁止单方面修改。

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  account      String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())

  // 会话令牌（决策 I-8 认证约定：不透明随机串、存库校验、不使用 JWT）。
  // 只存 SHA-256 哈希，不存明文；sessionTokenExpiresAt 为 ISO 8601 UTC 字符串。
  sessionTokenHash      String? @unique
  sessionTokenExpiresAt String?

  memberships   ProjectMember[]
  ownedProjects Project[]          @relation("ProjectOwner")
  ownedTasks    Task[]             @relation("TaskOwner")
  acceptedTasks Task[]             @relation("TaskAcceptor")
  visibility    ObjectVisibility[]
  // US-09（工单 #29）：这个人执行过的验收（反向关系，见文件末尾 AcceptanceRecord）
  acceptances   AcceptanceRecord[] @relation("AcceptanceActor")
  // US-10（工单 #30）：这个人负责的风险（反向关系，见文件末尾 Risk）
  ownedRisks    Risk[]             @relation("RiskOwner")
  // US-06（工单 #26）：这个人负责的里程碑（反向关系，见文件末尾 Milestone）
  ownedMilestones Milestone[]      @relation("MilestoneOwner")
  // US-15（工单 #35）：这个人负责的 UML 图（反向关系，见文件末尾 UmlDiagram）
  ownedUmlDiagrams UmlDiagram[]    @relation("UmlDiagramOwner")
  // #34 站内通知（ROLE-D 消费模块，公共存储由 ROLE-B 落地）：这个人收到的通知
  notifications    Notification[]  @relation("NotificationRecipient")
  // #36 任务附件：这个人上传的附件（反向关系，见文件末尾 Attachment）
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerUserId String
  // US-10（工单 #30）：项目生命周期。'ACTIVE' | 'CLOSED'；关闭前的阻断校验在本票模块。
  // 故意不进共享 `ProjectView`（#30 设计：端点自己返回，避免改项目模块序列化）。
  status      String   @default("ACTIVE") // ProjectStatus
  createdAt   DateTime @default(now())

  owner      User              @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  members    ProjectMember[]
  goals      BusinessGoal[]
  stories    UserStory[]
  tasks      Task[]
  visibility ObjectVisibility[]
  auditLogs  AuditLog[]
  // US-09（工单 #29）：本项目的验收记录（反向关系）
  acceptances AcceptanceRecord[]
  // US-10（工单 #30）：本项目的风险台账（反向关系，见文件末尾 Risk）
  risks       Risk[]
  // US-06（工单 #26）：本项目的里程碑 / 依赖边（反向关系，见文件末尾 Milestone / TaskDependency）
  // 注：`TaskMilestone` 只有 (taskId, milestoneId) 两列，无 projectId，故 Project 侧无对应反向关系。
  milestones       Milestone[]
  taskDependencies TaskDependency[]
  // US-15（工单 #35）：本项目的 UML 图（反向关系，见文件末尾 UmlDiagram）
  umlDiagrams      UmlDiagram[]
  // #37 领域事件：本项目的事件记录（反向关系，见文件末尾 DomainEvent）
  domainEvents     DomainEvent[]
  // #31 US-11：本项目的 AI 建议（反向关系，见文件末尾 AiSuggestion）
  aiSuggestions    AiSuggestion[]
  // #34 站内通知：本项目的通知（反向关系，见文件末尾 Notification）
  notifications    Notification[]
  // #36 任务附件：本项目的附件元数据（反向关系，见文件末尾 Attachment）
  attachments      Attachment[]
}

model ProjectMember {
  projectId String
  userId    String
  role      String // ProjectRole
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model BusinessGoal {
  id          String  @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      String  @default("ACTIVE") // GoalStatus
  sortOrder   Int

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activities UserActivity[]
  // US-15（工单 #35）：引用本目标的 UML 图（反向关系，见文件末尾 UmlDiagramGoal）
  umlDiagramLinks UmlDiagramGoal[]
}

model UserActivity {
  id          String  @id @default(uuid())
  projectId   String
  goalId      String
  name        String
  description String?
  status      String  @default("ACTIVE") // GoalStatus
  sortOrder   Int

  goal    BusinessGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  stories UserStory[]
  // US-15（工单 #35）：引用本活动的 UML 图（反向关系，见文件末尾 UmlDiagramActivity）
  umlDiagramLinks UmlDiagramActivity[]
}

model UserStory {
  id                 String   @id @default(uuid())
  projectId          String
  activityId         String
  title              String
  roleText           String
  capabilityText     String
  valueText          String
  businessValue      String
  priority           String // Priority
  status             String   @default("DRAFT") // StoryStatus
  acceptanceCriteria String?
  isSensitive        Boolean  @default(false)
  createdAt          DateTime @default(now())

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activity UserActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  tasks    Task[]
  // US-15（工单 #35）：引用本故事的 UML 图（反向关系，见文件末尾 UmlDiagramStory）
  umlDiagramLinks UmlDiagramStory[]
}

model Task {
  id             String   @id @default(uuid())
  projectId      String
  storyId        String
  title          String
  description    String?
  ownerUserId    String
  acceptorUserId String
  planStart      String // 'YYYY-MM-DD'
  planEnd        String // 'YYYY-MM-DD'
  status         String   @default("TODO") // TaskStatus
  progress       Int? // 已完成百分比 0-100；null = 未填
  blockedReason  String? // 卡住原因，仅 status = BLOCKED 时必填
  isSensitive    Boolean  @default(false)
  createdAt      DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  story    UserStory @relation(fields: [storyId], references: [id], onDelete: Restrict)
  owner    User      @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  acceptor User      @relation("TaskAcceptor", fields: [acceptorUserId], references: [id], onDelete: Restrict)
  // US-09（工单 #29）：这个任务的验收记录。**故意用 Cascade**（见文件末尾的说明）：
  // 端点 29 删除任务时验收记录随库级联清理，因此不必手写清理、也不必改 test-support 的删除顺序。
  acceptances AcceptanceRecord[]
  // US-10（工单 #30）：关联到本任务的风险（用于敏感可见性继承）。
  // 任务删除时置空（SetNull）而非级联删除：风险是独立台账，不应随任务消失。
  risks       Risk[]
  // US-06（工单 #26）：本任务关联的里程碑（多对多关联表）与 FS 依赖边（反向关系）
  milestoneLinks          TaskMilestone[]
  predecessorDependencies TaskDependency[] @relation("TaskPredecessor")
  successorDependencies   TaskDependency[] @relation("TaskSuccessor")
  // US-15（工单 #35）：引用本任务的 UML 图。**Cascade**（见文件末尾说明）：任务删除时
  // 关联行随库级联清理，故既有端点 29（DELETE /tasks/:taskId）语义不变。
  umlDiagramLinks         UmlDiagramTask[]
  // #36 任务附件：本任务的附件。**SetNull** 而非 Cascade（见文件末尾 Attachment 说明）：
  // 任务删除**不得**被附件关系阻塞，且附件行要保留清理状态直到物理文件删除成功。
  attachments             Attachment[]
}

// US-09 任务验收（工单 #29）—— 验收记录。
//
// 为什么需要这张表：AC5 要求「重验可再次通过 / 驳回，全过程可追溯（who / when / 结论 / 原因）」。
// 验收结论与驳回原因没有别的落点 —— `Task.blockedReason` 的语义是「卡住原因」，
// 且非 BLOCKED 态会被端点 28 清空，把它当驳回原因用属语义挪用。
//
// 状态机依据（契约门 #24 的 ROLE-A 结论 comment 6233430993）：
//   验收人把 DONE 的任务 → CLOSED（PASS）或 → DOING（REJECT，必填原因）。
//   因此 `statusBefore` 恒为 'DONE'，`statusAfter` 为 'CLOSED' 或 'DOING'；两列都存下来，
//   使这一行审计记录脱离 Task 表也读得懂（也容忍将来状态机变化）。
//
// 删除语义（本文件唯一的 Cascade）：task 用 Cascade —— 任务没了，它的验收历史就没有意义，
//   且可避免在旧模块（端点 29 的删除路径）与 test-support 的 resetDatabase 里再加清理代码。
//   project / actor 仍按仓库惯例：project 用 Cascade（与 AuditLog / ObjectVisibility 一致），
//   actor 用 Restrict（人不该被删掉而留下无主的验收记录）。
model AcceptanceRecord {
  id           String   @id @default(uuid())
  projectId    String
  taskId       String
  actorUserId  String
  conclusion   String // AcceptanceConclusion: 'PASS' | 'REJECT'
  reason       String? // 驳回时必填（服务端强制）；通过时选填
  statusBefore String // 验收前的任务状态（按 #24 结论恒为 'DONE'）
  statusAfter  String // 'CLOSED'（通过）或 'DOING'（驳回）
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor   User    @relation("AcceptanceActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  // 读路径：按任务查历史（旧→新）、按项目查（供 #30 / #33 的质量信号读取）
  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
}

model ObjectVisibility {
  projectId  String
  objectType String // VisibilityObjectType: 'story' | 'task'
  objectId   String // 多态列，无外键（见上方特殊约定）
  userId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([objectType, objectId, userId])
  @@index([objectType, objectId])
  @@index([projectId, objectType])
}

// US-10 风险台账（工单 #30）—— 项目风险的落点。
//
// 为什么需要这张表：AC3 要求「风险支持三级 + 四态，非法值拒绝」，AC7 要求「敏感风险
// 不计入无权者的总数与清单」；项目模块没有任何字段能承载风险台账。
//
// 口径来源（契约门 #24 的 ROLE-A 结论，2026-10-18 人工确认）：
//   - 三级：高 / 中 / 低；四态：未处理 / 处理中 / 已解决 / 已关闭；
//     线上取值与 Zod 枚举由 `src/modules/risk/` 定义（本文件的 String 列不约束枚举，
//     与仓库既有惯例一致：枚举合法性由 `src/shared/validation.ts` / 本域校验保证）。
//   - 权限：`risk.write` = PM + MEMBER（VIEWER 一律 403 只读，见 permissions.ts 第 5.5 条）；
//     「风险状态四态流转是否限 PM、MEMBER 能否改 status / 重开」由 ROLE-A 在业务层按 #30 口径定，
//     本文件与 permissions.ts 只保证「MEMBER 可写、VIEWER 不可写」这一层。
//   - 敏感风险继承所关联任务的敏感可见性，**不扩展** `VisibilityObjectType`。
//
// 删除语义：project → Restrict（与 Task / UserStory 等业务对象一致，项目不应被删掉而留下孤儿风险）；
//   owner → Restrict（人不该被删掉而留下无主风险）；task → SetNull（风险独立于任务存在）。
model Risk {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?
  level       String // RiskLevel: 'HIGH' | 'MEDIUM' | 'LOW'
  status      String   @default("OPEN") // RiskStatus: 'OPEN' | 'IN_PROGRESS' | 'RESOLVED' | 'CLOSED'
  ownerUserId String
  taskId      String? // 可选关联任务（敏感可见性继承的入口）
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner   User    @relation("RiskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // 读路径：按项目 + 状态列清单；按负责人 / 任务查关联
  @@index([projectId, status])
  @@index([ownerUserId])
  @@index([taskId])
}

model AuditLog {
  id          String   @id @default(uuid())
  projectId   String
  actorUserId String
  action      String
  objectType  String
  objectId    String
  before      String?
  after       String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// US-06 甘特图（工单 #26）—— 里程碑、任务—里程碑关联、FS 依赖边。
//
// 为什么需要这三张表：AC1 要求同一视图展示需求 / 任务 / 里程碑，AC4 要求任务可关联里程碑
// 并汇总，AC5/AC6 要求仅 FS 依赖、拒绝自环 / 越项目边。既有 9 张表没有任何字段能承载
// 里程碑、任务—里程碑多对多或任务间依赖，故本票新增。
//
// 枚举列全部为 String（SQLite 无原生 enum，与文件头第 1 条一致）：
//   TaskDependency.type 本期仅接受 'FS'，其余值由写入层拒绝（见设计 §4.2）。
//
// 删除语义理由：
//   Milestone.projectId → Restrict：与 Task / UserStory 等业务对象一致，项目不应被删掉而留下孤儿里程碑。
//   Milestone.ownerUserId → Restrict：人不该被删掉而留下无主里程碑。
//   TaskMilestone 两端 → Cascade：关联行只是任务与里程碑之间的连接，任一端消失即失去意义。
//   TaskDependency.projectId → Restrict：本项目不再存在时，边不应留下孤儿。
//   TaskDependency 两端 → Restrict：删除任务不静默丢边（会影响旧 DELETE /tasks/:taskId，见设计 §3.2）。
model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  dueDate     String // 'YYYY-MM-DD'（自然日，Asia/Shanghai）
  ownerUserId String? // 可选负责人；里程碑可无单独负责人（通知口径）
  createdAt   DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner   User?            @relation("MilestoneOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  tasks   TaskMilestone[]

  @@index([projectId])
  @@index([ownerUserId])
}

// 任务—里程碑多对多关联（设计 §3.1 候选 A）：不侵入 Task 表，天然支持一个任务关联多个里程碑。
model TaskMilestone {
  taskId      String
  milestoneId String

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([taskId, milestoneId])
  @@index([milestoneId])
}

model TaskDependency {
  id                String   @id @default(uuid())
  projectId         String // 冗余项目边界，便于同项目校验与过滤
  predecessorTaskId String
  successorTaskId   String
  type              String   @default("FS") // 本期仅接受 'FS'，写入层拒绝其他值
  createdAt         DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  predecessor Task    @relation("TaskPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Restrict)
  successor   Task    @relation("TaskSuccessor", fields: [successorTaskId], references: [id], onDelete: Restrict)

  @@unique([predecessorTaskId, successorTaskId, type])
  @@index([projectId])
  @@index([predecessorTaskId])
  @@index([successorTaskId])
}

// US-15 在线 UML（工单 #35）—— 用例图 / 时序图的最小模型。
//
// 为什么需要这 7 张表：AC1 要求「在线创建并编辑用例图与时序图（非仅上传）」，
// AC2 要求「图可关联项目 / 业务目标 / 用户活动 / 用户故事 / 任务」。既有表没有任何字段
// 能承载图、节点、边或类型化关联，故本票新增。依据：`docs/role-b-uml-design.md` §3（FROZEN v1.0）。
//
// 三处关键取舍（设计 §3.1）：
//   ① 不落任何几何坐标：只落结构 + 序（`UmlNode.orderIndex` 生命线序、`UmlEdge.seq` 消息序）。
//      已批准口径明确「不做自动布局 / 自由画布语义校验」，落坐标会把画布语义带回来。
//   ② 4 张真实关联表（Goal / Activity / Story / Task）各两个真实外键、两端 Cascade：
//      多态列（如 `ObjectVisibility`）无外键 ⇒ 无 DB 级联 ⇒ 删任务后留孤儿关联行，与
//      已批准口径「关联行 Cascade」冲突；且若对任务引用用 Restrict，会让**既有
//      `DELETE /tasks/:taskId`（端点 29）开始失败**。
//   ③ 两类图共用 3 张表（`UmlDiagram` / `UmlNode` / `UmlEdge`），用 `kind` + `nodeType` /
//      `edgeType` 判别；枚举合法性由写入层（Zod）保证，与文件头第 1 条一致（DB 不约束枚举）。
//
// 删除语义理由（设计 §3.6）：
//   UmlDiagram.projectId   → Restrict：项目不应被删掉而留下孤儿图。
//   UmlDiagram.ownerUserId → Restrict：人不该被删掉而留下无主图。
//   UmlNode / UmlEdge → UmlDiagram → Cascade：图内容的从属物。
//   UmlEdge 两端 → UmlNode（复合外键）→ Cascade：节点删除后残留边即脏数据。
//   4 张关联表两端 → Cascade：关联行只是连接，任一端消失即失去意义；删任务 / 故事时
//     关联行自动消失，旧删除端点零改动。
//
// 边同图约束由数据库兜底（设计 §3.3 / §3.7 实测）：`UmlEdge` 用**复合外键**
//   `(diagramId, sourceNodeId)` / `(diagramId, targetNodeId) → UmlNode(diagramId, id)`，
//   因此「A 图的边指向 B 图的节点」在物理上不可能落库（跨图建边得 P2003），
//   不依赖写入层是否漏检。为此 `UmlNode` 必须有 `@@unique([diagramId, id])` 作为引用目标。
model UmlDiagram {
  id          String   @id @default(uuid())
  projectId   String
  kind        String // 'USECASE' | 'SEQUENCE'；创建后不可变（写入层保证）
  title       String
  description String?
  ownerUserId String // 创建时取当前 PM；可转移给任意项目成员（写入层校验）
  // ★ 持久「曾经受限」guard（2026-10-21 项目负责人裁定 A；`DECISIONS.md` `uml.no-auto-declassification-guard`）：
  //   一旦本图曾关联过敏感对象即置 true 且**永不自动清除**；非 PM 读一律 404（与「不存在」逐字一致），
  //   以堵住「解除最后一个受限关联 → every(empty)=true → 正文对成员自动公开」的降密路径。
  //   显式降密属另案（需 PM 动作 + 审计），本期不做。
  everRestricted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner   User    @relation("UmlDiagramOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  nodes      UmlNode[]
  edges      UmlEdge[]
  goals      UmlDiagramGoal[]
  activities UmlDiagramActivity[]
  stories    UmlDiagramStory[]
  tasks      UmlDiagramTask[]

  // 列表主查询（按项目 + 类型）；负责人维度的「我的图」；
  // ★ 非 PM 读取条件含 `everRestricted = false`（guard），故索引第三列跟随
  //   （迁移 `20261021120000_add_uml_ever_restricted` 已建同名索引；
  //   2026-10-21 补齐 schema 声明，消除 `prisma migrate diff` 漂移）。
  @@index([projectId, kind])
  @@index([projectId, kind, everRestricted])
  @@index([ownerUserId])
}

model UmlNode {
  id         String   @id @default(uuid())
  diagramId  String
  nodeType   String // 用例图：'ACTOR' | 'USECASE'；时序图：'LIFELINE'
  name       String
  orderIndex Int      @default(0) // 序，不是坐标：时序图生命线横向排列序；用例图恒 0
  createdAt  DateTime @default(now())

  diagram UmlDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  // 复合外键的目标（UmlEdge 用 (diagramId, id) 引用），故必须唯一
  outgoingEdges UmlEdge[] @relation("UmlEdgeSource")
  incomingEdges UmlEdge[] @relation("UmlEdgeTarget")

  @@unique([diagramId, id])
  @@index([diagramId])
}

model UmlEdge {
  id           String   @id @default(uuid())
  diagramId    String
  edgeType     String // 用例图：'ASSOCIATION' | 'INCLUDE' | 'EXTEND'；时序图：'SYNC' | 'ASYNC' | 'RETURN'
  sourceNodeId String
  targetNodeId String
  label        String?
  seq          Int? // 仅时序图（消息序号，服务端分配）；用例图恒 null
  createdAt    DateTime @default(now())

  diagram UmlDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  // 复合外键把 diagramId 一起带进引用目标 ⇒ 边两端必然属于同一张图（DB 兜底，见上方说明）
  source UmlNode @relation("UmlEdgeSource", fields: [diagramId, sourceNodeId], references: [diagramId, id], onDelete: Cascade)
  target UmlNode @relation("UmlEdgeTarget", fields: [diagramId, targetNodeId], references: [diagramId, id], onDelete: Cascade)

  // 时序图内 seq 唯一（注意：是「唯一」不是「严格递增」，递增语义只能由写入层保证）；
  // SQLite 唯一索引允许多个 NULL ⇒ 用例图多条 seq = null 的边可共存（设计 §3.3 / §3.7 实测）
  @@unique([diagramId, seq])
  @@index([diagramId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// 图 ↔ 业务目标（目标 / 活动无敏感维度，恒对项目成员可见；见设计 §Z）
model UmlDiagramGoal {
  diagramId String
  goalId    String

  diagram UmlDiagram   @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  goal    BusinessGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([diagramId, goalId])
  @@index([goalId])
}

// 图 ↔ 用户活动
model UmlDiagramActivity {
  diagramId  String
  activityId String

  diagram  UmlDiagram   @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  activity UserActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([diagramId, activityId])
  @@index([activityId])
}

// 图 ↔ 用户故事（可见性交集口径的输入之一）
model UmlDiagramStory {
  diagramId String
  storyId   String

  diagram UmlDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  story   UserStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([diagramId, storyId])
  @@index([storyId])
}

// 图 ↔ 任务（可见性交集口径的另一输入；**两端 Cascade** 是保住端点 29 删除语义的关键）
model UmlDiagramTask {
  diagramId String
  taskId    String

  diagram UmlDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  task    Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([diagramId, taskId])
  @@index([taskId])
}

// #37 领域事件（ROLE-D 的信封，公共表由 ROLE-B 落地）—— 事件持久化落点。
//
// 为什么需要：D 的进程内实现只把事件放在内存里（模块测试用），AC 要求事件可持久化、
// 可查询、可重放；且 `(projectId, eventName, idempotencyKey)` 的幂等去重必须由数据库
// 唯一约束兜底（并发 publish 时内存 Map 不足以保证）。
//
// 字段取信封（`src/shared/events.ts` 的 `DomainEventEnvelope`）：
//   object  → objectType / objectId；
//   actor   → actorKind + actorUserId? / actorComponent?；
//   payload → payload（Json；敏感事件只存 references，见信封注释）。
//
// 时间列用 `DateTime` 而非 String：查询的时间范围必须走**原生时间比较**，
// 字符串字典序会把带偏移量（如 `+08:00`）的 ISO 串排错（D 的内存桩正是这个缺陷）。
//
// 删除语义：project → Restrict（与 Task / Risk / Milestone / UmlDiagram 一致，项目不应被删掉
// 而留下孤儿事件）；actor 相关列只是字符串快照，不建外键（事件是历史事实，不应因用户被删而丢失）。
//
// 不建 outbox / 投递状态表：本批不承诺 exactly-once 与可靠投递（见 `DECISIONS.md`
// `arch.shared-ports-and-assembly` 与 D 的协议 §5）。
model DomainEvent {
  id             String   @id @default(uuid())
  schemaVersion  Int
  eventName      String
  projectId      String
  objectType     String
  objectId       String
  actorKind      String // 'USER' | 'SYSTEM'（枚举合法性由写入层保证，与文件头第 1 条一致）
  actorUserId    String?
  actorComponent String?
  occurredAt     DateTime
  storedAt       DateTime
  idempotencyKey String
  correlationId  String?
  causationId    String?
  sensitive      Boolean
  payload        Json

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // 幂等唯一作用域（D 的信封契约固定为 projectId + eventName + idempotencyKey）
  @@unique([projectId, eventName, idempotencyKey])
  // 读路径：按项目 + 时间范围列事件；按项目 + 事件名筛选
  @@index([projectId, occurredAt])
  @@index([projectId, eventName])

  // #34 站内通知（ROLE-B 公共运行时）：通知行与消费账本都以原事件为不可悬空的来源
  // （`onDelete: Restrict`，见 `notifications.source-event-provenance`）。这里只是反向关系，
  // 不加列、不新增索引，故不影响既有事件表。
  notifications Notification[]
  consumptions  NotificationConsumption[]
}

// #31 US-11 AI 建议（ROLE-D 的共享「建议 + 处置」存储，公共表由 ROLE-B 落地）。
//
// 为什么需要：D 的进程内实现只把建议放在内存里（模块测试用）；AC 要求建议、处置与应用结果
// 可持久化，且「唯一最终处置」必须由数据库约束兜底（并发处置时内存 Map 不足以保证）。
// 依据：`DECISIONS.md` `ai.suggestion-store-shared`（一套共享存储，字段至少覆盖 8 类）、
//   `permissions.ai-suggestion-disposal`（处置仅 PM）、`arch.shared-ports-and-assembly`；
//   `docs/role-d/ROLE-D-US11-public-integration-request.md`。
//
// 三张表（`AiSuggestion` / `AiDisposition` / `AiApplication`）而不是 1:1 合并的理由：
//   1. `AiDisposition.suggestionId` 作为**主键**（1:1 子表）把「唯一最终处置」变成可实测的
//      DB 级约束 —— 同一建议的第二条处置在物理上无法落库（P2002），并发下恰好一次成功；
//   2. `AiApplication` 是可变的（应用失败可重试），与不可变的建议正文 / 快照分离；
//   3. 与 D 的 `AiSuggestionRecord{ disposition, application }` 嵌套结构一一对应，映射直观。
//
// 「status 为唯一真源」（裁定 6）：`AiSuggestion.status` 是生命周期唯一真源；
//   `application.status` 不落库，读取时按 `src/shared/ai.ts` 的派生规则计算。
//
// 时间列用 `DateTime`（DATETIME）而非 String：`generatedAt` / `disposedAt` / `appliedAt` 的
//   范围查询与排序必须走**原生时间比较**（与 `DomainEvent` 同款理由）。
//
// 删除语义：project → Restrict（与 Task / Risk / Milestone / UmlDiagram / DomainEvent 一致，
//   项目不应被删掉而留下孤儿建议）；disposition / application → Cascade（从属物，随建议消失）。
// 明确不建外键到 `User`：`generatedByUserId` / `disposedByUserId` / `appliedByUserId` 是
//   操作者**字符串快照**，属历史事实，不应因用户被删而丢失（与 `DomainEvent` 的 actor 同款）。
// **不得**用 `AuditLog` 当建议存储（`DECISIONS.md` `ai.suggestion-store-shared`）。
model AiSuggestion {
  id                           String   @id @default(uuid())
  projectId                    String
  scenario                     String // AiScenario
  sourceObjectType             String
  sourceObjectId               String
  status                       String // AiSuggestionStatus —— **唯一真源**
  generatedByUserId            String
  generatedAt                  DateTime
  // 生成追溯（`AiGenerationTrace`；`generationStatus` = SUCCEEDED | FAILED | TIMED_OUT）
  generationStatus             String
  generationRequestId          String
  generationErrorCode          String? // AiDomainFailureCode（与顶层 ErrorCode 区分）
  generationErrorMessage       String?
  generationRetryable          Boolean?
  // 模型或桩标识与实际可得版本（未知版本记「未提供」）
  modelProvider                String
  modelName                    String
  modelVersion                 String
  modelMode                    String // STUB | API
  modelExecution               String // LOCAL | EXTERNAL
  // 建议内容（不可变模型输出；人工修改落在 AiDisposition）
  suggestion                   Json?
  // 输入范围与基数（`AiInputScope`）
  inputScope                   Json
  // 快照 + 指纹（`AiSnapshot`；算法 SHA-256_CANONICAL_JSON_V1）
  snapshotAsOf                 DateTime
  snapshotData                 Json
  snapshotFingerprint          String
  snapshotFingerprintAlgorithm String
  createdAt                    DateTime @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  disposition AiDisposition?
  application AiApplication?

  // 列表主查询：按项目 + 场景 + 生成时间倒序（原生时间比较）
  @@index([projectId, scenario, generatedAt])
  // 查询层可见性过滤：按项目 + 来源对象（story / task）
  @@index([projectId, sourceObjectType, sourceObjectId])
}

// 唯一最终处置（1:1 子表）。`suggestionId` 同时是主键 ⇒ 同一建议最多一条最终处置，
// 由数据库物理兜底；`PENDING → 最终` 的条件更新（CAS）作用在 `AiSuggestion.status` 上。
//
// 幂等三元组 `(suggestionId, actorUserId, requestId)`（裁定 3）：由于 `suggestionId` 主键
// 已保证唯一，三元组只用于**重放判定**（同 actor 同 requestId 同 `contentDigest` → REPLAY；
// 否则 CONFLICT；不同 actor 不算同一请求）。`contentDigest` 由 `canonicalAiJsonDigest` 按
// `SHA-256_CANONICAL_JSON_V1`（稳定键序 + 码元比较）算出。
model AiDisposition {
  suggestionId     String   @id
  status           String // ACCEPTED | MODIFIED | REJECTED
  disposedByUserId String
  disposedAt       DateTime
  requestId        String
  contentDigest    String
  reason           String? // MODIFIED / REJECTED 必填（校验层强制）
  modification     Json?
  finalContent     Json?

  suggestion AiSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  // 重放判定读路径（项目内按处置人 + 请求标识回溯）
  @@index([disposedByUserId, requestId])
}

// 应用结果（1:1 子表，可变：应用失败可重试）。
//
// `status` **不落库**：`application.status` 是 `AiSuggestion.status` 的派生视图（裁定 6）。
// 本表只存应用事实：时间、操作者、结果摘要白名单对象与目标引用；CAS 期望状态集合
// `{DISPOSED, APPLICATION_FAILED}`（裁定 5，应用失败可重试）。
model AiApplication {
  suggestionId     String   @id
  appliedAt        DateTime
  appliedByUserId  String
  result           Json?
  targetReferences Json // AiSourceObjectRef[]

  suggestion AiSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
}

// #34 站内通知（ROLE-D 的消费模块；公共存储 / 消费账本由 ROLE-B 落地）。
//
// 为什么需要：D 的进程内实现只把通知放在内存里（模块测试用）；AC 要求通知可持久化、
// 可按收件人查询、去重必须由数据库唯一约束兜底（并发消费时内存 Map 不足以保证），
// 且 `notifications.source-event-provenance` 要求通知的来源事件不可悬空。
//
// 字段与 `src/modules/notification/contracts.ts` 的 `NotificationRecord` 一一对应：
//   reference      → referenceObjectType / referenceObjectId
//   content        → contentKind（'TEXT' | 'REFERENCE_ONLY'）/ contentTitle / contentSummary
//   occurredAt / storedAt → DATETIME（与 DomainEvent 同款：必须原生时间比较与排序）
//   latencyMs      → INTEGER（**允许负值**：事件时间在未来时保留原始差值，不归零伪装达标）
//
// 删除语义：
//   projectId / recipientUserId → Restrict（与 Task / Risk 等一致，项目/人不该被删掉而留下孤儿通知）。
//   sourceEventId → DomainEvent **Restrict**（`notifications.source-event-provenance`：通知存续期间
//     原事件不是可任意删除的缓存；未来留存清理另案）。
//
// 索引：`@@index([recipientUserId, isRead, storedAt])` 支撑「按收件人 + 未读 + 时间倒序」的
//   列表主查询；`@@index([sourceEventId])` 支撑原事件 join 与来源外键。
model Notification {
  id                  String   @id @default(uuid())
  projectId           String
  recipientUserId     String
  type                String // NotificationType
  sourceEventId       String
  sourceEventName     String
  dedupeKey           String   @unique
  referenceObjectType String
  referenceObjectId   String
  contentKind         String // 'TEXT' | 'REFERENCE_ONLY'
  contentTitle        String?
  contentSummary      String?
  sensitive           Boolean
  occurredAt          DateTime
  storedAt            DateTime
  latencyMs           Int
  withinDeliveryTarget Boolean
  isRead              Boolean  @default(false)
  readAt              DateTime?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recipient   User        @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  sourceEvent DomainEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, isRead, storedAt])
  @@index([sourceEventId])
}

// #34 通知消费激活记录（每个 consumerId 一条，只写一次）。
//
// 首次启用时在同一事务写入激活记录，并把当时已存在的支持事件在消费账本里记为
// SKIPPED_BASELINE（`notifications.committed-consumption-and-query-contract`）：
// 不自动群发旧风险、重启不重置基线。`activatedDay` 为启用日（Asia/Shanghai，'YYYY-MM-DD'），
// 兼作里程碑 `milestone.due` 启动补扫的下界（「不补启用日前的旧节点」）。
model NotificationConsumer {
  consumerId  String   @id
  activatedAt DateTime
  activatedDay String // 'YYYY-MM-DD'（Asia/Shanghai）
  createdAt   DateTime @default(now())

  consumptions NotificationConsumption[]
}

// #34 持久消费账本（`(consumerId, eventId)` 唯一）。
//
// 以「是否已有账本行」判断事件是否已处理完成，而不是靠 storedAt / id 水位防重：
//   - `DELIVERED`：处理器返回 DELIVERED 才落该状态；
//   - `SKIPPED_BASELINE`：首次启用时对历史支持事件登记，表示「已按策略跳过、不投递」；
//   - UNAVAILABLE / 异常**不落账本**，因此可重试（至少一次尝试 + 幂等，无 outbox）。
//
// 删除语义：consumerId → NotificationConsumer Restrict；eventId → DomainEvent Restrict
//（账本的事件引用同样保留，见 `notifications.source-event-provenance`）。
model NotificationConsumption {
  consumerId String
  eventId    String
  status     String // 'DELIVERED' | 'SKIPPED_BASELINE'
  note       String?
  createdAt  DateTime @default(now())

  consumer NotificationConsumer @relation(fields: [consumerId], references: [consumerId], onDelete: Restrict)
  event    DomainEvent          @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([consumerId, eventId])
  @@index([eventId])
}

// #36 任务附件（ROLE-D 的附件能力公共接入，公共表由 ROLE-B 落地）。
//
// 为什么需要：D 的进程内实现只把附件元数据放在内存里（模块测试用）；AC 要求元数据入库、
// 实体文件落 `var/uploads/`，且任务删除后**失败可追踪重试**。
// 依据：`DECISIONS.md` `attachments.policy`（白名单 / 10MB / 扩展名+MIME 联合校验 /
//   元数据入库 / 实体文件 var/uploads / 任务删除联动可追踪重试）、
//   `attachments.storage-and-cleanup`（B 的删除语义裁定）、
//   `docs/role-d/ROLE-D-ATTACH-interface-protocol.md` §5 / §6。
//
// 删除语义（B 的裁定 1，**不用 Cascade**）：
//   - `taskId` 可空 + 外键 `onDelete: SetNull`：任务删除**不得**被附件关系阻塞；
//   - 任务删除在**同一事务**内把该任务 `ACTIVE` 附件标为 `DELETING`（记录 `deleteRequestedAt`），
//     事务提交后由清理执行器删除物理文件：成功 → 删行；失败 → `CLEANUP_FAILED` +
//     累加 `cleanupAttempts` + 记录 `cleanupLastError`，可重试；
//   - 绝不允许「先删实体」；列表 / 详情只返回 `state = 'ACTIVE'`。
//   - 用 Cascade 会让清理状态随行消失、失败无法重试，故明确排除。
//
// 删除语义（其余外键）：`projectId → Project` 用 **Restrict**（与 Task / Risk / DomainEvent /
//   AiSuggestion 一致，项目不应被删掉而留下孤儿附件）；`uploaderUserId → User` 用 **Restrict**
//   （与 Task.ownerUserId 一致，人不应被删掉而留下无主附件）。
//
// 时间列用 `DateTime`（DATETIME）而非 String：清理扫描 / 排序走**原生时间比较**（与
//   `DomainEvent` / `AiSuggestion` 同款理由）。
//
// `storagePath` 唯一：磁盘存储键 = 服务端 UUID + 已验证扩展名，同一键绝不覆盖写入；
//   原始文件名只作元数据（`originalName`），**不参与磁盘路径拼接**。
model Attachment {
  id                String    @id @default(uuid())
  projectId         String
  // 可空：任务删除时 SetNull，使任务删除不被附件关系阻塞（清理状态保留在 state 列）
  taskId            String?
  uploaderUserId    String
  originalName      String // 原始文件名，仅元数据
  extension         String // AttachmentExtension
  mimeType          String // AttachmentMime（与 extension 联合校验后落库）
  sizeBytes         Int
  storagePath       String    @unique // 磁盘存储键（UUID + 扩展名）
  state             String    @default("ACTIVE") // AttachmentState: ACTIVE | DELETING | CLEANUP_FAILED
  createdAt         DateTime  @default(now())
  deleteRequestedAt DateTime? // 任务删除联动标记 DELETING 的时间戳
  cleanupAttempts   Int       @default(0) // 物理删除失败次数
  cleanupLastError  String? // 安全错误码（如 FILE_DELETE_FAILED），不含敏感细节
  deletedAt         DateTime? // 清理完成时间（预留：行删除前的时间戳语义）

  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task     Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploader User    @relation("AttachmentUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)

  // 清理扫描 / 按任务读 ACTIVE 列表
  @@index([taskId, state, createdAt])
  // 按项目 + 状态（项目级清理 / 审计读路径）
  @@index([projectId, state])
}
