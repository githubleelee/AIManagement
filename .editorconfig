root = true

# 团队同时在 Windows 编辑器与 WSL 下工作，此文件保证格式一致
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 的尾随空格是有意义的（强制换行），不清理
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.prisma]
indent_size = 2

[Makefile]
indent_style = tab
