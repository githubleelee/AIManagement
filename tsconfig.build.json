{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "web",
    "src/**/*.test.ts",
    "src/**/test-fixtures.ts",
    "src/**/*-fixtures.ts"
  ]
}
